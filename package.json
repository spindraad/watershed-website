{
  "name": "watershed-website",
  "version": "0.1.0-beta.24",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "postinstall": "node postinstall.js",
    "docker:start": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "build": "run-p build:*",
    "build:app": "react-router build",
    "build:storybook": "storybook build",
    "dev": "run-p dev:*",
    "dev:app": "react-router dev",
    "dev:storybook": "storybook dev --no-open -p 6006",
    "test": "run-p test:unit:watch test:components",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest --watch",
    "test:unit:coverage": "vitest --coverage",
    "test:components": "test-storybook",
    "test:components:watch": "test-storybook --watch",
    "test:components:coverage": "test-storybook --coverage",
    "test:components:ci": "concurrently --kill-others --success first --names \"storybook,test\" --prefix-colors \"magenta,blue\" --pad-prefix \"npm run storybook:serve\" \"npm run storybook:wait-until-reachable && npm run test:components\"",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "migrate-puck-data": "tsx ./scripts/run-puck-migration.ts",
    "qa": "run-p lint typecheck",
    "qa:full": "run-p lint typecheck test:unit test:components",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:push:seed": "prisma db push && prisma db seed",
    "db:push:reset": "prisma db push --force-reset",
    "db:push:reset:seed": "prisma db push --force-reset && prisma db seed",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio --browser none",
    "db:deploy:dev": "npm run db:migrate:reset -- --force",
    "db:diff": "./scripts/diff-db-staging.zsh",
    "playwright:install": "playwright install --with-deps",
    "storybook:serve": "http-server storybook-static -p 6006 --silent",
    "storybook:wait-until-reachable": "wait-on tcp:6006",
    "generate": "plop -- ",
    "generate:component": "plop component --",
    "generate:form": "plop form --",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "release:beta": "npm version prerelease",
    "postversion": "git push && git push --tags"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.969.0",
    "@aws-sdk/lib-storage": "^3.969.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@faker-js/faker": "^9.2.0",
    "@mjackson/file-storage": "^0.6.1",
    "@mjackson/form-data-parser": "^0.7.0",
    "@prisma/client": "^5.21.0",
    "@puckeditor/core": "0.21.0",
    "@puckeditor/plugin-heading-analyzer": "0.21.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@sendgrid/mail": "^8.1.6",
    "@shoelace-style/shoelace": "^2.20.1",
    "@tanstack/react-query": "^5.90.17",
    "@tinymce/tinymce-react": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "fs-extra": "^11.3.3",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-fetch-backend": "^6.0.0",
    "isbot": "^5.1.32",
    "leaflet": "^1.9.4",
    "mime": "^4.1.0",
    "pretty-cache-header": "^1.0.0",
    "prisma": "^5.21.0",
    "prisma-json-types-generator": "^3.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.4.1",
    "react-router": "^7.12.0",
    "remix-i18next": "^7.4.2",
    "remix-utils": "^7.7.0",
    "tiny-invariant": "^1.3.3",
    "tinymce": "^7.6.0",
    "typescript": "^5.9.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@react-router/dev": "^7.12.0",
    "@react-router/remix-routes-option-adapter": "^7.12.0",
    "@storybook/addon-a11y": "^8.6.4",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.4",
    "@storybook/addon-onboarding": "^8.6.4",
    "@storybook/addon-viewport": "^8.6.4",
    "@storybook/blocks": "^8.6.14",
    "@storybook/experimental-addon-test": "^8.6.14",
    "@storybook/preview-api": "^8.6.14",
    "@storybook/react": "^8.6.4",
    "@storybook/react-vite": "^8.6.4",
    "@storybook/test": "^8.6.15",
    "@storybook/test-runner": "^0.22.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.14.15",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.23",
    "commander": "^14.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-storybook": "^0.11.4",
    "globals": "^15.11.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "i18next-http-backend": "^3.0.2",
    "lint-staged": "^15.2.10",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.57.0",
    "plop": "^4.0.4",
    "postcss": "^8.5.6",
    "prettier": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "remix-flat-routes": "^0.8.5",
    "storybook": "^8.6.4",
    "storybook-addon-remix-react-router": "^4.0.1",
    "storybook-react-i18next": "^3.2.1",
    "tailwindcss": "^3.4.14",
    "tailwindcss-plugin-custom-elements": "^1.0.0",
    "tsx": "^4.21.0",
    "vite": "^5.4.11",
    "vite-env-only": "^3.0.3",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.5",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run lint -- --fix",
      "npm run format --"
    ]
  },
  "prisma": {
    "seed": "tsx ./prisma/seed/main.ts"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
