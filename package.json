{
  "name": "watershed-website",
  "version": "0.1.0-beta.16",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "postinstall": "node postinstall.js",
    "docker:start": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "build": "run-p build:*",
    "build:remix": "remix vite:build",
    "build:storybook": "storybook build",
    "dev": "run-p dev:*",
    "dev:remix": "remix vite:dev",
    "dev:storybook": "storybook dev --no-open -p 6006",
    "test": "run-p test:unit test:components",
    "test:unit": "vitest",
    "test:unit:watch": "vitest --watch",
    "test:unit:coverage": "vitest --coverage",
    "test:components": "test-storybook",
    "test:components:watch": "test-storybook --watch",
    "test:components:coverage": "test-storybook --coverage",
    "test:components:ci": "concurrently --kill-others --success first --names \"storybook,test\" --prefix-colors \"magenta,blue\" --pad-prefix \"npm run storybook:serve\" \"npm run storybook:wait-until-reachable && npm run test:components\"",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:push:seed": "prisma db push && prisma db seed",
    "db:push:reset": "prisma db push --force-reset",
    "db:push:reset:seed": "prisma db push --force-reset && prisma db seed",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio --browser none",
    "db:deploy:dev": "npm run db:migrate:reset -- --force",
    "playwright:install": "playwright install --with-deps",
    "storybook:serve": "http-server storybook-static -p 6006 --silent",
    "storybook:wait-until-reachable": "wait-on tcp:6006",
    "generate": "plop component --",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "release:beta": "npm version prerelease",
    "postversion": "git push && git push --tags"
  },
  "dependencies": {
    "@faker-js/faker": "^9.2.0",
    "@measured/puck": "^0.18.2",
    "@prisma/client": "^5.21.0",
    "@remix-run/node": "^2.13.1",
    "@remix-run/react": "^2.13.1",
    "@remix-run/serve": "^2.13.1",
    "@sendgrid/mail": "^8.1.3",
    "@shoelace-style/shoelace": "^2.18.0",
    "@tinymce/tinymce-react": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "fs-extra": "^11.2.0",
    "i18next": "^23.16.5",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-fetch-backend": "^6.0.0",
    "isbot": "^5.1.17",
    "pretty-cache-header": "^1.0.0",
    "prisma": "^5.21.0",
    "prisma-json-types-generator": "^3.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.1.1",
    "remix-i18next": "^6.4.1",
    "remix-utils": "^7.7.0",
    "tiny-invariant": "^1.3.3",
    "tinymce": "^7.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.1.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.0",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.49.0",
    "@remix-run/dev": "^2.13.1",
    "@storybook/addon-a11y": "^8.4.5",
    "@storybook/addon-essentials": "^8.4.5",
    "@storybook/addon-interactions": "^8.4.5",
    "@storybook/addon-links": "^8.4.5",
    "@storybook/addon-onboarding": "^8.4.5",
    "@storybook/addon-viewport": "^8.4.5",
    "@storybook/blocks": "^8.4.5",
    "@storybook/experimental-addon-test": "^8.4.5",
    "@storybook/preview-api": "^8.4.5",
    "@storybook/react": "^8.4.5",
    "@storybook/react-vite": "^8.4.5",
    "@storybook/test": "^8.4.5",
    "@storybook/test-runner": "^0.19.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.15",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.12.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-storybook": "^0.11.1",
    "globals": "^15.11.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.6",
    "i18next-http-backend": "^3.0.1",
    "lint-staged": "^15.2.10",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.49.0",
    "plop": "^4.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "remark-gfm": "^4.0.0",
    "remix-flat-routes": "^0.6.5",
    "storybook": "^8.4.5",
    "storybook-addon-remix-react-router": "^3.0.1",
    "storybook-react-i18next": "^3.1.7",
    "tailwindcss": "^3.4.14",
    "tailwindcss-plugin-custom-elements": "^1.0.0",
    "vite": "^5.4.11",
    "vite-env-only": "^3.0.3",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.5",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run lint -- --fix",
      "npm run format --"
    ]
  },
  "prisma": {
    "seed": "tsx ./prisma/seed/main.ts"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
