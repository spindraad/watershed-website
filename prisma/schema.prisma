// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator json {
  provider = "prisma-json-types-generator"
}

enum PasswordType {
  ACTIVE
  RESET
}

model PasswordReset {
  id String @id @default(cuid())

  email     String
  token     String   @unique @default(uuid())
  expiresAt DateTime

  createdAt DateTime @default(now())
}

model Password {
  hash String

  type PasswordType @default(ACTIVE)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(cuid())

  email String @unique
  name  String

  password Password?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id String @id @default(cuid())

  /// [Localised]
  title Json

  /// [Localised]
  description Json

  /// [Localised]
  summary Json

  slug String

  imageUrl String?
  imageAlt String?

  /// [LocalisedContent]
  content Json?

  makers Maker[] @relation("ProjectMakers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id String @id @default(cuid())

  /// [Localised]
  title Json

  /// [Localised]
  description Json

  organiser String?

  imageUrl String?
  imageAlt String?

  link String

  eventDate DateTime

  address String

  /// [LocalisedContent]
  content Json?

  makers Maker[] @relation("EventMakers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Page {
  id String @id @default(cuid())

  /// [LocalisedContent]
  content Json

  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id String @id @default(cuid())

  /// [Localised]
  title Json

  slug String @unique

  order    Int
  parentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Maker {
  id String @id @default(cuid())

  name String

  /// [Localised]
  profession Json

  /// [Localised]
  summary Json

  slug     String  @unique
  imageUrl String?
  imageAlt String?

  /// [LocalisedContent]
  content Json?

  talentPrograms TalentProgram[] @relation("TalentProgramMakers")
  events         Event[]         @relation("EventMakers")
  projects       Project[]       @relation("ProjectMakers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TalentProgram {
  id String @id @default(cuid())

  /// [Localised]
  title Json

  duration String?

  /// [Localised]
  description Json

  imageUrl String?
  imageAlt String?

  /// [LocalisedContent]
  content Json?

  makers Maker[] @relation("TalentProgramMakers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CandyShopCategory {
  id String @id @default(cuid())

  /// [Localised]
  title Json

  /// [Localised]
  description Json

  items CandyShopItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CandyShopItem {
  id String @id @default(cuid())

  /// [Localised]
  title Json

  /// [Localised]
  description Json

  imageUrl String?
  imageAlt String?

  /// [LocalisedContent]
  content Json?

  category   CandyShopCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RubriekCategory {
  id String @id @default(cuid())

  /// [Localised]
  title Json

  /// [Localised]
  description Json

  rubrieken Rubriek[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rubriek {
  id String @id @default(cuid())

  /// [Localised]
  title Json

  /// [Localised]
  description Json

  imageUrl String?
  imageAlt String?

  /// [LocalisedContent]
  content Json?

  category   RubriekCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
