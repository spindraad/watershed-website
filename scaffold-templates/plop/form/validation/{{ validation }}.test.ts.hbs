import { describe, test, expect } from 'vitest';
import { validate{{ validation }} } from './{{ validation }}';

describe('validate "{{ validation }}"', () => {
  test('should return success: false', async () => {
    const formData = new FormData();
    formData.append('name', 'Donald Duck');

    const request = new Request('https://localhost:3000/login', {
      method: 'POST',
      body: formData,
    });

    const result = await validate{{ validation }}(request);

    expect(result).toEqual({
      success: false,
      errors: {
        name: [{ errorCode: 'invalid_type' }],
      },
    });
  });

  test('should return success: true', async () => {
    const formData = new FormData();
    formData.append('name', 'Donald Duck');

    const request = new Request('https://localhost:3000/login', {
      method: 'POST',
      body: formData,
    });

    const result = await validate{{ validation }}(request);

    expect(result).toEqual({
      success: true,
      data: {
        name: 'Donald Duck',
      },
    });
  });
});
